#!/usr/bin/env bash
# Links the skills of this repository for Claude Code and Codex, and wt on PATH:
#   ~/.agents/skills/<name>  -> <repo>/skills/<name>
#   ~/.claude/skills/<name>  -> ../../.agents/skills/<name>
#   ~/.codex/skills/<name>   -> ../../.agents/skills/<name>   (only when ~/.codex exists)
#   ~/.local/bin/wt          -> <repo>/bin/wt
# Idempotent; never replaces a file, a directory or a symlink it did not create.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: bin/install [--dry-run] [--uninstall]

Links every skill in skills/ into ~/.agents/skills, ~/.claude/skills and
~/.codex/skills, and links bin/wt into ~/.local/bin. Safe to run again.

  --dry-run    print what would change and change nothing
  --uninstall  remove only the links that point into this repository
EOF
}

REPO=$(cd "$(dirname "$0")/.." && pwd -P)
dry_run=0
uninstall=0
for arg in "$@"; do
  case $arg in
    --dry-run) dry_run=1 ;;
    --uninstall) uninstall=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

changed=0
conflicts=0

report() {
  printf '%-9s %s\n' "$1" "$2"
}

ensure_link() {
  local link=$1 target=$2
  if [ -L "$link" ]; then
    if [ "$(readlink "$link")" = "$target" ]; then
      report ok "$link"
    else
      report conflict "$link -> $(readlink "$link") (expected $target); left untouched"
      conflicts=$((conflicts + 1))
    fi
  elif [ -e "$link" ]; then
    report conflict "$link exists and is not a symlink; left untouched"
    conflicts=$((conflicts + 1))
  else
    report link "$link -> $target"
    changed=$((changed + 1))
    if [ "$dry_run" = 0 ]; then
      mkdir -p "$(dirname "$link")"
      ln -s "$target" "$link"
    fi
  fi
}

remove_link() {
  local link=$1 target=$2
  if [ -L "$link" ] && [ "$(readlink "$link")" = "$target" ]; then
    report remove "$link"
    changed=$((changed + 1))
    if [ "$dry_run" = 0 ]; then
      rm "$link"
    fi
  fi
}

agents_dir="$HOME/.agents/skills"
client_dirs=("$HOME/.claude/skills")
if [ -d "$HOME/.codex" ]; then
  client_dirs+=("$HOME/.codex/skills")
else
  report skip "$HOME/.codex not found (Codex not installed)"
fi

for skill_dir in "$REPO"/skills/*/; do
  [ -f "$skill_dir/SKILL.md" ] || continue
  name=$(basename "$skill_dir")
  own_target="$REPO/skills/$name"
  relative_target="../../.agents/skills/$name"
  if [ "$uninstall" = 1 ]; then
    if [ -L "$agents_dir/$name" ] && [ "$(readlink "$agents_dir/$name")" = "$own_target" ]; then
      for client in "${client_dirs[@]}"; do
        remove_link "$client/$name" "$relative_target"
      done
      remove_link "$agents_dir/$name" "$own_target"
    fi
  else
    ensure_link "$agents_dir/$name" "$own_target"
    for client in "${client_dirs[@]}"; do
      ensure_link "$client/$name" "$relative_target"
    done
  fi
done

if [ "$uninstall" = 1 ]; then
  remove_link "$HOME/.local/bin/wt" "$REPO/bin/wt"
else
  ensure_link "$HOME/.local/bin/wt" "$REPO/bin/wt"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) report note "$HOME/.local/bin is not on PATH; add it to your shell profile" ;;
  esac
fi

if [ "$dry_run" = 1 ]; then
  printf 'dry run: %d change(s) would be made, %d conflict(s)\n' "$changed" "$conflicts"
else
  printf '%d change(s), %d conflict(s)\n' "$changed" "$conflicts"
fi
[ "$conflicts" -eq 0 ]
